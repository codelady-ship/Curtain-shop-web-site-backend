SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/properde
SPRING_DATASOURCE_USERNAME=postgres
# Required: no default password
SPRING_DATASOURCE_PASSWORD=
# Required, at least 32 bytes (e.g. `openssl rand -base64 48`). Local dev alternative: SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=
JWT_TTL_SECONDS=86400

# Admin reset kodu email göndərişi üçün SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=

# Admin reset kodu WhatsApp göndərişi üçün Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Admin account created on the first admin login. ADMIN_PASSWORD is required (min 12 chars);
# without it the admin is not created and admin login is refused.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated frontend origins allowed by CORS (scheme + host, no path)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://codelady-ship.github.io

# Neon example (SSL required):
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
